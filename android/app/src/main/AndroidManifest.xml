<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The optional fallback needs GLES 3.2; Vulkan remains the preferred renderer. -->
    <uses-feature android:glEsVersion="0x00030002" android:required="false" />
    <!-- Vulkan is preferred, but it is optional so the bundled OpenGL ES 3.2 fallback remains installable. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x00401000" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MadagascarApplication"
        android:allowBackup="false"
        android:appCategory="game"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/LauncherTheme">
        <activity
            android:name=".GameActivity"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:preferMinimalPostProcessing="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" />
        <activity
            android:name=".TouchEditorActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="@string/touch_editor_title"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LauncherTheme" />
        <activity
            android:name=".LauncherActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
